# Systemd-Benutzerdienst. Installation siehe README.md in diesem Ordner.
[Unit]
Description=Emres Assistent: Telegram-Brücke
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/assistent
ExecStart=/usr/bin/python3 %h/assistent/bruecken/telegram/bridge.py
Restart=on-failure
RestartSec=10
# Claude Code liegt oft in ~/.local/bin oder in einem npm-Verzeichnis
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
